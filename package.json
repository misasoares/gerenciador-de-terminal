{
  "name": "gerenciador-de-terminal",
  "version": "0.7.1",
  "homepage": "https://github.com/misasoares/gerenciador-de-terminal",
  "private": true,
  "description": "Gerenciador de terminais para sessões do Claude Code",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "pack": "electron-vite build && electron-builder --mac --dir && sh scripts/mac-sign.sh",
    "pack:linux": "sh scripts/build-linux.sh",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "motion": "^12.43.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "dev.misasoares.gerenciador-terminal",
    "productName": "Gerenciador de Terminal",
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/electron-liquid-glass/**"
    ],
    "extraResources": [
      {
        "from": "resources/update-helper.sh",
        "to": "update-helper.sh"
      }
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Claude Code usa o microfone para o ditado por voz (/voice) nas sessões abertas nos terminais."
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "misasoares <misasoaresms2@gmail.com>",
      "artifactName": "gerenciador-de-terminal-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "git",
        "netcat-openbsd",
        "procps"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib",
        "git",
        "nmap-ncat",
        "procps-ng"
      ]
    }
  },
  "author": "misasoares",
  "license": "UNLICENSED",
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
